# ZhipuAI Embedding API
ZHIPU_API_KEY=your_zhipu_api_key

# LLM (mimo-v2.5 via ChatOpenAI compatible endpoint)
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=mimo-v2.5-pro

# DashScope (qwen-flash for query classification)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-flash

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# Reranker model local path (Jina v3)
RERANKER_MODEL_PATH=./models/jina-reranker-v3

# Data directory (knowledge bases, uploads, BM25 indexes)
DATA_DIR=./data

# Embedding model config
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=512

# MinerU PDF解析 (可选, 用于precision模式)
MINERU_API_TOKEN=your_mineru_api_token

# JWT Authentication Secret Key (必须在生产环境中更改)
SECRET_KEY=your-secret-key-change-in-production

# Development mode (set to true for local dev, allows random SECRET_KEY)
DEVELOPMENT=false

# CORS origins (comma-separated, e.g. https://your-domain.com)
# Leave empty for same-origin only (production default)
CORS_ORIGINS=
